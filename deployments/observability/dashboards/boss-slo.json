{
  "title": "BOSS SLO 看板(S1-S3)",
  "uid": "boss-slo",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "S1 API 可用性(非5xx占比 1h)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(boss_http_requests_total{code!~\"5..\"}[1h])) / sum(rate(boss_http_requests_total[1h]))" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.99 }, { "color": "green", "value": 0.995 } ] } } }
    },
    {
      "id": 2, "type": "stat", "title": "S2 读时延达标率(≤500ms 占比 1h)",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [{ "expr": "sum(rate(boss_http_request_duration_seconds_bucket{le=\"0.5\"}[1h])) / sum(rate(boss_http_request_duration_seconds_bucket{le=\"+Inf\"}[1h]))" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 0.98 }, { "color": "green", "value": 0.99 } ] } } }
    },
    {
      "id": 3, "type": "stat", "title": "boss-server 存活",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [{ "expr": "max(up{job=\"boss-server\"})" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } }
    },
    {
      "id": 4, "type": "timeseries", "title": "请求速率(按 code)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [{ "expr": "sum by (code) (rate(boss_http_requests_total[5m]))", "legendFormat": "{{code}}" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "时延 P50/P95/P99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(boss_http_request_duration_seconds_bucket[5m])))", "legendFormat": "P50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(boss_http_request_duration_seconds_bucket[5m])))", "legendFormat": "P95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(boss_http_request_duration_seconds_bucket[5m])))", "legendFormat": "P99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Top10 慢接口 P95",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "targets": [{ "expr": "topk(10, histogram_quantile(0.95, sum by (le, path) (rate(boss_http_request_duration_seconds_bucket[5m]))))", "legendFormat": "{{path}}" }],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
