# 102 应用容器环境变量(真实部署用;复制为 app.env 填写,app.env 不入库)
# 用法:cp app.env.example app.env && docker compose -f docker-compose.102.app.yml up -d
# compose 中 environment 段保留非密默认值;密钥类只在本文件注入。

# ---------- 认证 ----------
BOSS_JWT_SECRET=change-me             # 生产必须换强随机值

# ---------- 超管引导(首启幂等创建 sysadmin,已存在不覆盖;创建后可清空) ----------
BOSS_ADMIN_USERNAME=admin
BOSS_ADMIN_PASSWORD=

# ---------- 数据/消息(默认对准 102 基础设施,按需覆盖) ----------
#BOSS_PG_DSN=host=192.168.0.102 port=25432 user=boss password=boss dbname=boss sslmode=disable
#BOSS_KAFKA_BROKERS=192.168.0.102:29092

# ---------- 实名二要素自动核验(阿里云实人认证 Id2MetaVerify;留空=不启用,提交落 PENDING 人工核验) ----------
#BOSS_REALID_ALIYUN_AK_ID=
#BOSS_REALID_ALIYUN_AK_SECRET=

# ---------- 生产(k8s+ingress)段:域名/TLS 见 docs/notes/adopted/2026-08-20-prod-domain-tls.md ----------
# 公开域名,三门户同域路径前缀:/api/admin /api/user /api/worker;TLS 由 ingress cert-manager 终结。
# Android/桌面客户端生产基址:https://boss.ymm.cn/api/user/v1(师傅端 /api/worker/v1,admin /api/admin)。
#BOSS_PUBLIC_BASE_URL=https://boss.ymm.cn

# ---------- 系统授权门禁(release-platform 离线授权;默认关闭=完全放行) ----------
# 启用后业务接口须持有有效离线证书;激活入口 admin 基础配置-系统授权页(登录即可达)。
#BOSS_LICENSE_ENABLED=true
#BOSS_LICENSE_PUBLIC_KEY_HEX=            # release-platform 离线签发公钥(hex ed25519,必填否则启动失败)
#BOSS_LICENSE_PRODUCT_ID=boss-server      # release-platform 产品 ID
#BOSS_LICENSE_CERT_PATH=/var/lib/boss/license.json
#BOSS_LICENSE_DEVICE_ID=                 # 默认 hostname
#BOSS_LICENSE_FINGERPRINT=               # 机器指纹,默认读 /etc/machine-id
#BOSS_LICENSE_API_BASE_URL=http://192.168.0.102:38080
#BOSS_LICENSE_API_TOKEN=                 # release-platform API token(rpat_);env 直传或 BOSS_LICENSE_API_TOKEN_FILE 文件注入
#BOSS_LICENSE_LEEWAY_MINUTES=5
