# check-contract-sync baseline:已知且有意接受的差异。
# 规则:新增差异禁止进此文件;只有"存量债务 + 明确整改意图"才允许登记。
# 每条必须有登记理由与整改方向。

# ---- C. 超 300 行存量(08-18 体检发现,列入整改清单) ----
# addresses 系列已拆 http_address.go,http_org.go 豁免已移除(2026-08-18)

# ---- A. 路由参数命名历史差异 ----
# 用户端产品详情实现使用 :id,对外 OpenAPI 使用 {productId};路径形状相同,
# Gin 不允许同路径仅更换参数名,待统一契约实现时一次迁移。
route:/products/{id}

# ---- D. 迁移编号历史撞号(D 项门禁上线时体检发现,2026-08-22) ----
# migrator 以完整文件名为版本键,两者均已应用、功能正常;编号唯一惯例自此门禁起
# 强制,历史不改名(改名需同步 schema_migrations,风险大于收益)。
mig:000044
mig:000095
