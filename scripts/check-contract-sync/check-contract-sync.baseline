# check-contract-sync baseline:已知且有意接受的差异。
# 规则:新增差异禁止进此文件;只有"存量债务 + 明确整改意图"才允许登记。
# 每条必须有登记理由与整改方向。

# ---- C. 超 300 行存量(08-18 体检发现,列入整改清单) ----
# addresses 系列已拆 http_address.go,http_org.go 豁免已移除(2026-08-18)

# ---- A. 路由参数命名历史差异 ----
# 用户端产品详情实现使用 :id,对外 OpenAPI 使用 {productId};路径形状相同,
# Gin 不允许同路径仅更换参数名,待统一契约实现时一次迁移。
route:/products/{id}

# ---- D. 迁移编号历史撞号(D 项门禁上线时体检发现,2026-08-22) ----
# migrator 以完整文件名为版本键,两者均已应用、功能正常;编号唯一惯例自此门禁起
# 强制,历史不改名(改名需同步 schema_migrations,风险大于收益)。
mig:000044
mig:000095

# ---- A2. 方法级对账存量(2026-09-07 A2 检查落地首扫,登记 6 条) ----
# geo names ×2:契约把 DELETE 登记在父路径 /names,实现用深层路径
# /names/{locale}/{nameType} 定位单条——契约侧改成深层路径即消除。
a2:method:admin DELETE /geo/countries/{code}/names
a2:method:admin DELETE /geo/subdivisions/{code}/names
# GET /faqs 假阳性已消除(2026-09-07 提取器补 helper 形态,helper_routes.go),
# 本条按其整改方向移除;stripe×2 与 products ×3 条仍待契约侧整改。
# stripe done/cancel:契约登记为 API 端点,实为 H5 静态提示页(order.yaml successUrl
# 描述"缺省走 /pay/stripe/done 静态提示页")——契约标注非 API 或移除即消除。
a2:spec:user GET /pay/stripe/done
a2:spec:user GET /pay/stripe/cancel
# 产品详情:契约同路径登记了 {productId} 写法,实现为 {id}(与上 A 段同因,
# 契约多文件重复登记口径不一)——契约统一参数名后移除本条。
a2:spec:user GET /products/{productId}

