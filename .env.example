# BOSS 服务端环境变量示例(internal/pkg/config/config.go 为唯一权威来源)
# 复制为 .env 后按需修改;.env 已被 .gitignore 忽略,不会入库。

# ---------- 基础 ----------
BOSS_HTTP_ADDR=:8080                  # HTTP 监听地址
BOSS_GRPC_ADDR=:9090                  # gRPC 监听地址
BOSS_CORS_ORIGINS=http://localhost:5173,http://localhost:5174 # 本地客户端允许的跨域来源
BOSS_PG_DSN=host=192.168.0.102 port=25432 user=boss password=boss dbname=boss sslmode=disable

# ---------- 认证 ----------
BOSS_JWT_SECRET=change-me             # 生产必须换强随机值

# ---------- 超管引导(启动幂等创建 sysadmin;密码非空才启用,已存在不覆盖) ----------
BOSS_ADMIN_USERNAME=admin
BOSS_ADMIN_PASSWORD=                  # 留空=跳过引导;首启前填强口令,创建后可清掉

# ---------- 消息/事件 ----------
BOSS_KAFKA_BROKERS=192.168.0.102:29092
BOSS_EVENTS_TOPIC=boss-order-events

# ---------- AAA(阶段7 RADIUS) ----------
BOSS_AAA_AUTH_ADDR=:1812
BOSS_AAA_ACCT_ADDR=:1813
BOSS_AAA_SECRET=boss-aaa-secret
BOSS_AAA_CDR_TOPIC=boss-cdr

# ---------- Provisioner(阶段7 下发) ----------
BOSS_PROVISION_OLT_ADDR=0
BOSS_PROVISION_OLT_USER=admin
BOSS_PROVISION_OLT_PASS=admin

# ---------- Collector(阶段7 SNMP 采集) ----------
BOSS_SNMP_TARGETS=                    # 格式 code@host:port,...
BOSS_SNMP_COMMUNITY=public
BOSS_SNMP_OPTICAL_OID=1.3.6.1.4.1.100.1
BOSS_SNMP_PACKETLOSS_OID=1.3.6.1.4.1.100.2
BOSS_SNMP_STATUS_OID=1.3.6.1.2.1.2.2.1.8

# ---------- Analytics / Report(阶段9) ----------
BOSS_ANALYTICS_BACKEND=pg             # pg | starrocks
BOSS_STARROCKS_DSN=root@tcp(192.168.0.102:29030)/
BOSS_REPORT_PERIOD=daily              # daily/weekly/monthly/quarterly
BOSS_REPORT_PUSH_TOPIC=boss-report-snapshots

# ---------- 102 扩展基础设施 ----------
BOSS_APISIX_ADMIN=http://192.168.0.102:29180
BOSS_PROMETHEUS_URL=http://192.168.0.102:19090
BOSS_ALERTMANAGER_URL=http://192.168.0.102:19093
BOSS_GRAFANA_URL=http://192.168.0.102:19300
BOSS_LOKI_URL=http://192.168.0.102:19310
BOSS_JAEGER_OTLP=192.168.0.102:16831
BOSS_FLINK_JM=192.168.0.102:18082
