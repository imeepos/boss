<?xml version="1.0" encoding="utf-8"?>
<!--
  cleartext 收敛(2026-08-27 上线计划 D0):release 默认禁止明文,仅白名单内网/联调
  域名放行 http。首发为内网直装(192.168.0.102);debug 联调域 43.240.223.138;
  模拟器回环 10.0.2.2/localhost。https 公网迁移列首发后第一技术债(换此白名单即可)。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.102</domain>
        <domain includeSubdomains="false">43.240.223.138</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>