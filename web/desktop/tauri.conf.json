{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOSS Admin",
  "version": "0.1.0",
  "identifier": "com.ymm.boss.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../admin dev --host 127.0.0.1",
    "beforeBuildCommand": "pnpm --dir ../admin build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../admin/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
